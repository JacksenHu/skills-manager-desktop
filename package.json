{
  "name": "skills-manager-desktop",
  "version": "0.3.0",
  "description": "跨 Agent 技能共享库的桌面管理程序：Junction 联接 / 技能库 / 更新检测 / 托盘",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "check:tables": "node scripts/check-tables.mjs",
    "verify:align": "node scripts/verify-alignment.mjs",
    "verify:p4": "node scripts/p4-smoke.mjs",
    "verify:p5": "node scripts/p5-smoke.mjs",
    "verify:p6": "node scripts/p6-smoke.mjs",
    "verify:all": "node scripts/check-tables.mjs && node scripts/verify-alignment.mjs && node scripts/p4-smoke.mjs && node scripts/p5-smoke.mjs && node scripts/p6-smoke.mjs"
  },
  "author": "JacksenHu",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JacksenHu/skills-manager-desktop.git"
  },
  "build": {
    "appId": "com.jacksenhu.skills-manager-desktop",
    "productName": "SkillsManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "JacksenHu",
      "repo": "skills-manager-desktop",
      "releaseType": "release"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "技能共享库管理"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
